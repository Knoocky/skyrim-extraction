@@ -37,3 +37,40 @@ TEST_CASE("Potions restore health", "[Restoration]")
   p.DestroyActor(0xff000000);
   DoDisconnect(p, 0);
 }
+
+namespace {
+class ConsumptionVetoListener : public PartOneListener
+{
+public:
+  bool block = true;
+  void OnConnect(Networking::UserId) override {}
+  void OnDisconnect(Networking::UserId) override {}
+  void OnCustomPacket(Networking::UserId, const simdjson::dom::element&) override {}
+  bool OnMpApiEvent(const GameModeEvent& event) override
+  {
+    return !block || std::string(event.GetName()) != "onEatItem";
+  }
+};
+}
+
+TEST_CASE("Vetoed potion neither heals nor consumes inventory", "[Restoration][Extraction]")
+{
+  PartOne& p = GetPartOne();
+  DoConnect(p, 0);
+  p.CreateActor(0xff000000, { 0, 0, 0 }, 0, 0x3c);
+  p.SetUserActor(0, 0xff000000);
+  auto& ac = p.worldState.GetFormAt<MpActor>(0xff000000);
+  ac.AddItem(0x3EAE3, 2);
+  ac.SetPercentages({ 0.1f, 0.f, 0.f });
+  auto listener = std::make_shared<ConsumptionVetoListener>();
+  p.AddListener(listener);
+  const bool result = ac.OnEquip(0x3EAE3);
+  const auto count = ac.GetInventory().GetItemCount(0x3EAE3);
+  const auto health = ac.GetChangeForm().actorValues.healthPercentage;
+  listener->block = false;
+  p.DestroyActor(0xff000000);
+  DoDisconnect(p, 0);
+  REQUIRE_FALSE(result);
+  REQUIRE(count == 2);
+  REQUIRE(health == 0.1f);
+}
